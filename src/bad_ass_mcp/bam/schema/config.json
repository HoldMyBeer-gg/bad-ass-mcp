{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bam.holdmybeer.gg/schema/v1/config.json",
  "title": "BAM suite config (bam.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "window": {
      "allOf": [
        {
          "$ref": "#/$defs/per_platform_string"
        }
      ],
      "description": "Substring of the app's main window: matched against the listed name (process name on macOS, title on Windows, AT-SPI app name on Linux) and every top-level window title, case-insensitive. May be per-platform."
    },
    "app": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        {
          "type": "object",
          "description": "Per-platform value: macos / windows / linux (null = not on that platform).",
          "properties": {
            "macos": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "windows": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "linux": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ],
      "description": "Launch command, string or argv list."
    },
    "allow_temp_saving_mfa_codes": {
      "type": "boolean",
      "description": "Allow a setup shell entry to save its output (a pairing or MFA code) with \"save\" for later steps. The value is kept in memory for the run only and shown as ••• in every output. Only honoured from the runner's own config file or command line."
    },
    "allow_secrets_in_plain_fields": {
      "type": "boolean",
      "description": "Allow a type step's secret into a field that isn't a password field. Its value would be visible, so once one is typed the run keeps no further screenshots and no video. Only honoured from the runner's own config file or command line."
    },
    "allow_password_fields": {
      "description": "Allow type steps into password fields: true for any app, or a list of window names (case-insensitive substring). Only honoured from the runner's own config file or command line, never from a script's configuration block.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "helpers": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "description": "Per-platform value: macos / windows / linux (null = not on that platform).",
          "properties": {
            "macos": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "windows": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "linux": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ],
      "description": "Other processes whose windows the run may drive, matched like `window`. For dialogs owned by a process that runs before the launch, e.g. \"xdg-desktop-portal\" for file pickers on Linux."
    },
    "pid": {
      "type": "integer",
      "description": "Attach mode: drive only this process's windows."
    },
    "ready": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/per_platform_string"
            },
            "role": {
              "$ref": "#/$defs/per_platform_string"
            },
            "state": {
              "$ref": "#/$defs/per_platform_string"
            },
            "note": {
              "$ref": "#/$defs/note"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "role"
              ]
            }
          ]
        },
        {
          "type": "object",
          "description": "Per-platform value: macos / windows / linux (null = not on that platform).",
          "properties": {
            "macos": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "role": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "state": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "note": {
                      "$ref": "#/$defs/note"
                    }
                  },
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "role"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "windows": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "role": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "state": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "note": {
                      "$ref": "#/$defs/note"
                    }
                  },
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "role"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "linux": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "role": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "state": {
                      "$ref": "#/$defs/per_platform_string"
                    },
                    "note": {
                      "$ref": "#/$defs/note"
                    }
                  },
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "role"
                      ]
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ],
      "description": "An element that exists only once the app is usable."
    },
    "launch_timeout": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "step_timeout": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timeout_scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "screenshot_proof": {
      "type": "boolean"
    },
    "demo": {
      "type": "boolean"
    },
    "demo_pace": {
      "type": "number",
      "minimum": 0
    },
    "annotate": {
      "type": "boolean"
    },
    "annotate_lead": {
      "type": "number",
      "minimum": 0
    },
    "record_video": {
      "enum": [
        true,
        false,
        "on_failure"
      ]
    },
    "fail_fast": {
      "enum": [
        true,
        false,
        "first_script"
      ]
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "note": {
      "$ref": "#/$defs/note"
    },
    "notes": {
      "$ref": "#/$defs/note"
    },
    "hang_timeout": {
      "type": "number",
      "minimum": 0,
      "description": "Seconds a window may stay unresponsive before the launched app is killed and the script fails (0 = off). Default 30."
    },
    "yield_to_user": {
      "type": "boolean",
      "description": "Stop the run (and the suite) when someone uses the keyboard or mouse during a script that sends real input. Default true."
    }
  },
  "$defs": {
    "per_platform_string": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "description": "Per-platform value: macos / windows / linux (null = not on that platform).",
          "properties": {
            "macos": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "windows": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "linux": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "only": {
      "type": "array",
      "items": {
        "enum": [
          "macos",
          "windows",
          "linux"
        ]
      },
      "uniqueItems": true,
      "description": "Run this only on these platforms."
    },
    "note": {
      "description": "For people; ignored by the runner.",
      "type": [
        "string",
        "array"
      ]
    }
  }
}
